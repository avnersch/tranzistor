{
  "expo": {
    "name": "טרנזיסטור",
    "slug": "Tranzistor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tranzistor-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/tranzistor-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ]
      },
      "bundleIdentifier": "com.tranzistor.radio"
    },
    "android": {
      "package": "com.tranzistor.radio",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/tranzistor-icon.png",
      "name": "טרנזיסטור",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/tranzistor"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-audio",
      "react-native-google-cast",
      "./plugins/withCastActivity",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "buildArchs": [
              "arm64-v8a"
            ],
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn expo.modules.**\n-keep class com.google.android.gms.cast.** { *; }\n-keep class com.google.android.gms.cast.framework.** { *; }\n-dontwarn com.google.android.gms.cast.**\n-keep class com.reactnative.googlecast.** { *; }\n-dontwarn com.reactnative.googlecast.**\n-keep class androidx.mediarouter.** { *; }\n-dontwarn androidx.mediarouter.**",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e0e674f-c9cc-425b-a3bc-55aa0290949b"
      }
    },
    "owner": "avnerz"
  }
}
